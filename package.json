{
  "name": "nekomimi",
  "version": "0.1.4",
  "description": "Observable local coding agent with a durable request and tool journal",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "nekomimi": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build && vitest run",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:pack": "npm run build && node scripts/pack-smoke.mjs",
    "dev:web": "vite",
    "test:browser": "npm run build && playwright test",
    "web": "node dist/cli.js web",
    "test:web-live": "npm run build && node scripts/web-live-smoke.mjs",
    "test:release": "node --test scripts/release-check.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "diff": "8.0.4",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "typebox": "1.3.7",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.9"
  },
  "license": "MIT",
  "author": "kirineko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirineko/nekomimi.git"
  },
  "homepage": "https://github.com/kirineko/nekomimi#readme",
  "bugs": {
    "url": "https://github.com/kirineko/nekomimi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "nekomimi",
    "deepseek",
    "ai",
    "coding-agent",
    "coding-assistant",
    "cli",
    "web-ui",
    "local-first",
    "observability"
  ]
}
