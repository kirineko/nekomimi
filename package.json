{
  "name": "nekomimi",
  "version": "0.2.1",
  "description": "Observable local coding agent with a durable request and tool journal",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "nekomimi": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "extension-docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build && node scripts/build-identity.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build && vitest run",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:pack": "npm run build && node scripts/pack-smoke.mjs",
    "dev:web": "vite",
    "test:browser": "npm run build && playwright test",
    "web": "node dist/cli.js web",
    "test:web-live": "npm run build && node scripts/web-live-smoke.mjs",
    "test:release": "node --test scripts/release-check.test.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "24.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "8.0.4",
    "esbuild": "0.28.1",
    "get-nonce": "1.0.1",
    "jiti": "2.7.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.2",
    "remark-gfm": "4.0.1",
    "semver": "7.8.5",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tar": "7.5.22",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.2",
    "vite": "8.3.0",
    "vitest": "4.1.9"
  },
  "license": "MIT",
  "author": "kirineko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirineko/nekomimi.git"
  },
  "homepage": "https://github.com/kirineko/nekomimi#readme",
  "bugs": {
    "url": "https://github.com/kirineko/nekomimi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "nekomimi",
    "deepseek",
    "ai",
    "coding-agent",
    "coding-assistant",
    "cli",
    "web-ui",
    "local-first",
    "observability",
    "customization",
    "skills",
    "mcp",
    "workflows"
  ]
}
